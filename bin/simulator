#!/bin/bash
#
# Starts this server with the simulator plugin (simulator/plugin) sailing the Miami sample.
#
# The server runs from its own configuration directory, .simulator/ (ignored by git): the
# server writes its defaults back into the settings file it runs with, so it is given a
# copy of settings/simulator.json, made fresh on every start, and the tracked file is
# never touched. Plugin settings and the saved run (scenario time and systems) persist there
# between runs; delete .simulator/ to start over. Pass further server options after it.

set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RUN="${ROOT}/.simulator"

npx --prefix "${ROOT}" tsc -p "${ROOT}/simulator/plugin"
mkdir -p "${RUN}/node_modules" "${RUN}/plugin-config-data"
cp "${ROOT}/settings/simulator.json" "${RUN}/settings.json"
ln -sfn "${ROOT}/simulator/plugin" "${RUN}/node_modules/signalk-simulator"

CONFIG="${RUN}/plugin-config-data/signalk-simulator.json"
if [ ! -f "${CONFIG}" ]; then
  cp "${ROOT}/settings/simulator-plugin.json" "${CONFIG}"
fi

exec "${ROOT}/bin/signalk-server" -c "${RUN}" "$@"
