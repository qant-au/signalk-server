#!/bin/bash
#
# The busy run (simulator/soak/README.md#busy-run): starts this server with the simulator
# plugin on a sample, traffic on, at x24, with WebSocket subscribers and REST readers, and
# measures whether it keeps up. The server runs from its own configuration directory,
# .simulator-busy/ (ignored by git), made fresh on every run, on port 4773 by default, so a
# running bin/simulator is left alone.
#
#   bin/simulator-busy <sample> [--hours N] [--multiplier N] [--subscribers N] [--readers N]
#                               [--start-at N] [--port N]

set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

npx --prefix "${ROOT}" tsc -p "${ROOT}/simulator/plugin"
npx --prefix "${ROOT}" tsc -p "${ROOT}/simulator/plugin/webapp"
exec npx --prefix "${ROOT}" ts-node "${ROOT}/simulator/tools/busy.ts" "$@"
