#!/bin/bash
#
# Replays a log bin/simulator-record wrote on a plain server: this server with no simulator
# plugin, its one provider the server's own file playback (providers/simple, FileStream,
# Multiplexed), which sends each delta at the time it was logged. The server runs from its
# own configuration directory, .simulator-replay/ (ignored by git), made fresh on every
# run from settings/simulator-replay.json, with the own boat's identity from the log in its
# vessel settings (simulator/tools/replay-settings.ts), on port 4776 by default (its NMEA 0183 and TCP
# streams on the next two), so a running bin/simulator is left alone. See
# simulator/soak/README.md#recording-and-replaying-a-run.
#
#   bin/simulator-replay <file> [--port N]

set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RUN="${ROOT}/.simulator-replay"

FILE="$1"
if [ -z "${FILE}" ] || [ ! -f "${FILE}" ]; then
  echo "usage: bin/simulator-replay <file> [--port N]" >&2
  exit 2
fi
FILE="$(cd "$(dirname "${FILE}")" && pwd)/$(basename "${FILE}")"
PORT=4776
if [ "$2" = "--port" ]; then PORT="$3"; fi

rm -rf "${RUN}"
mkdir -p "${RUN}"
npx --prefix "${ROOT}" ts-node "${ROOT}/simulator/tools/replay-settings.ts" "${FILE}" "${RUN}"

PORT="${PORT}" NMEA0183PORT="$((PORT + 1))" TCPSTREAMPORT="$((PORT + 2))" \
  exec "${ROOT}/bin/signalk-server" -c "${RUN}"
